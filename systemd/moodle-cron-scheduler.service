[Unit]
Description=Agendador centralizado de cron dos tenants Moodle
Wants=docker.service
After=docker.service

[Service]
Type=simple
ExecStart=/usr/local/sbin/moodle-cron-scheduler --daemon
EnvironmentFile=-/etc/default/moodle-cron-scheduler
Environment=MOODLE_CRON_LOCK_DIR=/run/moodle-cron-scheduler
Restart=always
RestartSec=5s
RuntimeDirectory=moodle-cron-scheduler
RuntimeDirectoryMode=0750
KillMode=control-group
TimeoutStopSec=30s
SyslogIdentifier=moodle-cron-scheduler
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
