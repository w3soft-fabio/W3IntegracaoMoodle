Provisioner__MoodleDockerRoot=/home/projetos/moodle-docker
Provisioner__StateRoot=/home/projetos/moodle-docker/.provisioner
Provisioner__WorkerEnabled=true
Provisioner__WorkerMaxParallelism=2
Provisioner__WorkerPollSeconds=2
Provisioner__Smtp__Server=smtp.example.com:587
Provisioner__Smtp__AuthType=LOGIN
Provisioner__Smtp__User=provisioner@example.com
Provisioner__Smtp__Password=CHANGE_ME
Provisioner__Smtp__Security=tls
Provisioner__Smtp__NoReplyAddress=no-reply@example.com
Provisioner__BigBlueButton__Enabled=false
Provisioner__BigBlueButton__RecordingEnabledByDefault=false
Provisioner__BigBlueButton__ServerUrl=
Provisioner__BigBlueButton__SharedSecret=
Provisioner__BigBlueButton__ChecksumAlgorithm=SHA256
