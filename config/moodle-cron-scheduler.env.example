# Descoberta recomendada: somente containers com o label
# com.w3soft.moodle.role=tenant.
MOODLE_CRON_DISCOVERY_MODE=label
MOODLE_CRON_TENANT_LABEL=com.w3soft.moodle.role=tenant

# Quantidade maxima de cron.php executados simultaneamente no host.
MOODLE_CRON_MAX_PARALLEL=8

# Um tenant que nao conseguir uma vaga nesse intervalo sera ignorado neste
# minuto e tentara novamente no ciclo seguinte.
MOODLE_CRON_QUEUE_TIMEOUT_SECONDS=50

# Zero permite que o cron termine naturalmente. Defina, por exemplo, 900 para
# interromper execucoes acima de 15 minutos.
MOODLE_CRON_COMMAND_TIMEOUT_SECONDS=0

# Apenas gera aviso; nao interrompe a execucao.
MOODLE_CRON_SLOW_WARNING_SECONDS=60
